+++ b/muscriptor/utils/capabilities.py
@@ -0,0 +1,29 @@
+"""Readiness checks never install software or download assets."""
+import hashlib
+import shutil
+from pathlib import Path
+
+
+def cached_asset(url):
+    from .download import _CACHE_DIR
+    if url.startswith('hf://'):
+        from huggingface_hub import try_to_load_from_cache
+        org, repo, filename = url[5:].split('/', 2)
+        return isinstance(try_to_load_from_cache(f'{org}/{repo}', filename), str)
+    name = url.split('/')[-1].split('?')[0]
+    return (_CACHE_DIR / f'{hashlib.sha256(url.encode()).hexdigest()[:8]}_{name}').is_file()
+
+
+def capabilities():
+    from .sheets import find_musescore
+    from .auralization import _LOCAL_SOUNDFONT
+    from ..soundfonts import SF2_URL, SF3_URL
+    try:
+        find_musescore()
+        sheets = True
+    except Exception:
+        sheets = False
+    synth = bool(shutil.which('fluidsynth'))
+    return dict(midi=True, sheets=sheets, fluidsynth=synth,
+                soundfont=_LOCAL_SOUNDFONT.is_file() or cached_asset(SF2_URL),
+                browser_soundfont=cached_asset(SF3_URL))
diff --git a/muscriptor/utils/partial.py b/muscriptor/utils/partial.py
new file mode 100644
index 0000000..45ff69c
--- /dev/null
+++ b/muscriptor/utils/partial.py
@@ -0,0 +1,73 @@
+"""Finish a streamed transcription at its last completed audio section."""
+from contextlib import closing, nullcontext
+from muscriptor.events import NoteStartEvent, NoteEndEvent, ProgressEvent
+from muscriptor.transcription_model import _SEGMENT_DURATION
+
+
+class FinishableTranscription:
+    def __init__(self, stream, duration, finish):
+        self.stream = iter(stream)
+        self.original_duration = self.duration = duration
+        self.finish = finish
+        self.events = []
+        self.completed = self.total = 0
+        self.checkpoint = 0
+        self.partial = False
+        self.finished = False
+
+    @property
+    def completed_seconds(self):
+        return min(self.original_duration, self.completed * _SEGMENT_DURATION)
+
+    @property
+    def can_finish(self):
+        return not self.finished and 0 < self.completed < self.total
+
+    def _requested(self):
+        return self.can_finish and self.finish is not None and self.finish.is_set()
+
+    def __iter__(self):
+        # Explicit close unwinds the decoder/GPU generator on every exit path.
+        with closing(self.stream) if hasattr(self.stream, "close") else nullcontext():
+            try:
+                while True:
+                    if self._requested():
+                        self._finish_prefix()
+                        return
+                    try:
+                        event = next(self.stream)
+                    except StopIteration:
+                        return
+                    if self._requested():
+                        self._finish_prefix()
+                        return
+                    if isinstance(event, ProgressEvent):
+                        self.completed, self.total = event.completed, event.total
+                        self.checkpoint = len(self.events)
+                    else:
+                        self.events.append(event)
+                    yield event
+            finally:
+                self.finished = True
+
+    def _finish_prefix(self):
+        self.partial = True
+        self.duration = self.completed_seconds
+        # Drop the in-flight section. Any notes held across the completed
+        # boundary receive a real note-off at that boundary, without moving
+        # their original onsets or leaving hanging MIDI notes.
+        result = []
+        open_notes = {}
+        for event in self.events[:self.checkpoint]:
+            if isinstance(event, NoteStartEvent):
+                if event.start_time < self.duration:
+                    open_notes[event.index] = event
+                    result.append(event)
+            elif event.start_event_index in open_notes:
+                result.append(NoteEndEvent(min(event.end_time, self.duration), open_notes.pop(event.start_event_index)))
+        result.extend(NoteEndEvent(self.duration, note) for note in open_notes.values())
+        self.events = result
+
+    @property
+    def notice(self):
+        return f"Partial transcription: saved the first {self.duration:.1f} seconds. The unfinished section and remaining audio were omitted."
