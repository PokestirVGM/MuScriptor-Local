+def read_audio(source) -> tuple[torch.Tensor, int]:
+    """Decode and validate one source before it reaches resampling/inference."""
+    try:
+        wav, sr = _read_wav_file(source)
+    except (wave.Error, EOFError):
+        if hasattr(source, 'seek'):
+            source.seek(0)
+        wav, sr = _read_non_wav_file(source)
+    if sr <= 0 or wav.ndim != 2 or not wav.shape[0] or not wav.shape[1]:
+        raise ValueError('Audio file contains no readable samples.')
+    if not torch.isfinite(wav).all():
+        raise ValueError('Audio file contains invalid sample values. Re-export the recording and try again.')
+    return wav, sr
+
