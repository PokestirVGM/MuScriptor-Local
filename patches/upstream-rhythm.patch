@@ -0,0 +1,31 @@
+import { useEffect, useRef, useState } from "react";
+
+type AppInfo = { model?: string; processor?: string; model_directory?: string };
+
+export function AppInfoDialog({ open, onClose }: { open: boolean; onClose: () => void }) {
+  const dialog = useRef<HTMLDialogElement>(null);
+  const [info, setInfo] = useState<AppInfo>({});
+  useEffect(() => {
+    if (!open) { dialog.current?.close(); return; }
+    dialog.current?.showModal();
+    const controller = new AbortController();
+    fetch("/app-info", { signal: controller.signal })
+      .then(response => response.ok ? response.json() : {})
+      .then(setInfo).catch(() => {});
+    return () => controller.abort();
+  }, [open]);
+  return <dialog ref={dialog} className="app-info-dialog" aria-labelledby="app-info-title" onClose={onClose} onClick={event => {
+    if (event.target === event.currentTarget) dialog.current?.close();
+  }}>
+    <div className="app-info-heading"><h2 id="app-info-title">MuScriptor</h2><button onClick={() => dialog.current?.close()}>Done</button></div>
+    <p>Independent adaptation by Pokestir</p>
+    <p className="app-info-version">Version {import.meta.env.VITE_APP_VERSION || "local edition"}</p>
+    <dl>
+      {info.model && <><dt>Model</dt><dd>{info.model}</dd></>}
+      {info.processor && <><dt>Processor</dt><dd>{info.processor}</dd></>}
+      {info.model_directory && <><dt>Model download folder</dt><dd className="app-info-path">{info.model_directory}</dd></>}
+    </dl>
+    <p>Use the desktop app’s gear menu to change the processor or open the model folder. Return to Desktop before changing the processor.</p>
+    <p>Audio is processed on this computer. Original MuScriptor by Kyutai and Mirelo.</p>
+  </dialog>;
+}
