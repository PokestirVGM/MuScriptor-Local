@@ -0,0 +1,76 @@
+import type { Dispatch, SetStateAction } from "react";
+
+export type TimingOptions = {
+  mode: string; bpm: string; meter: string; unit: string; first_downbeat: string;
+  quantize: boolean; subdivision: string; factor: number;
+  anchors: string; meter_changes: string;
+};
+export const defaultTiming: TimingOptions = {
+  mode: "auto", bpm: "120", meter: "auto", unit: "auto", first_downbeat: "0",
+  quantize: false, subdivision: "auto", factor: 1, anchors: "", meter_changes: "",
+};
+export function RhythmPanel({ value, onChange, busy, summary, warnings, onApply, click, onClickChange, dirty, error }: {
+  value: TimingOptions; onChange: Dispatch<SetStateAction<TimingOptions>>; busy: boolean;
+  summary?: string; warnings?: string[]; onApply?: () => void;
+  error?: string; click: boolean; onClickChange: (v: boolean) => void; dirty?: boolean;
+}) {
+  const set = (key: keyof TimingOptions, v: string | number | boolean) => onChange(s => ({ ...s, [key]: v }));
+  const commonMeters = ["auto", "2/4", "3/4", "4/4", "6/8", "9/8", "12/8", "5/4", "7/8"];
+  const customMeter = !commonMeters.includes(value.meter);
+  return <section className="rhythm-panel" aria-label="Timing settings">
+    <fieldset disabled={busy} className="rhythm-fields">
+      <div className="rhythm-main">
+        <label className="rhythm-field"><span>Tempo</span>
+          <select value={value.mode} onChange={e => onChange(s => ({...s, mode:e.target.value}))}>
+            <option value="auto">Auto</option><option value="manual">Manual</option>
+          </select>
+        </label>
+        <label className="rhythm-field"><span>Time signature</span>
+          <select value={customMeter ? "custom" : value.meter} onChange={e => set("meter",e.target.value === "custom" ? "5/8" : e.target.value)}>
+            {commonMeters.map(m => <option key={m} value={m}>{m === "auto" ? "Auto" : m}</option>)}
+            <option value="custom">Custom…</option>
+          </select>
+        </label>
+        <label className="rhythm-check"><input type="checkbox" checked={value.quantize} onChange={e => set("quantize",e.target.checked)} /><span>Strict quantization</span></label>
+      </div>
+      {(value.mode === "manual" || customMeter || value.quantize) && <div className="rhythm-secondary">
+        {value.mode === "manual" && <>
+          <label className="rhythm-field"><span>BPM</span><input type="number" min="10" max="600" step="any" value={value.bpm} onChange={e => set("bpm",e.target.value)} /></label>
+          <span className="rhythm-note">Sets the grid. Playback stays at the original speed.</span>
+        </>}
+        {customMeter && <label className="rhythm-field"><span>Custom signature</span><input value={value.meter} placeholder="5/8" onChange={e => set("meter",e.target.value)} /></label>}
+        {value.quantize && <label className="rhythm-field"><span>Snap to</span><select value={value.subdivision} onChange={e => set("subdivision",e.target.value)}>
+          <option value="auto">Auto</option><option value="2">Eighth notes</option><option value="4">Sixteenth notes</option><option value="3">Eighth-note triplets</option>
+        </select></label>}
+      </div>}
+      {value.quantize && <p className="rhythm-note">Snaps note starts and ends to the grid. Check the click first: an incorrect grid can make rhythm worse. Turn off to restore original timing.</p>}
+      <div className="rhythm-footer">
+        <details className="rhythm-advanced"><summary>Advanced</summary>
+          <div className="rhythm-advanced-content">
+            <p>Tempo sets the grid without changing playback speed. Quantization moves notes.</p>
+            <div className="rhythm-secondary">
+              <label className="rhythm-field"><span>BPM beat unit</span><select value={value.unit} onChange={e => set("unit",e.target.value)}>
+                <option value="auto">From time signature</option><option value="quarter">Quarter note</option><option value="dotted-quarter">Dotted quarter</option><option value="eighth">Eighth note</option>
+              </select></label>
+              <label className="rhythm-field"><span>Detected pulse</span><select value={value.factor} onChange={e => set("factor",Number(e.target.value))}>
+                <option value={1}>Normal</option><option value={0.5}>Half tempo</option><option value={2}>Double tempo</option>
+              </select></label>
+              {value.mode === "manual" && <label className="rhythm-field"><span>First downbeat (seconds)</span><input type="number" min="0" step="any" value={value.first_downbeat} onChange={e => set("first_downbeat",e.target.value)} /></label>}
+            </div>
+            <p>6/8 usually counts dotted-quarter beats. Check Auto’s meter suggestions; enter corrections below.</p>
+            <label className="rhythm-field"><span>Beat anchors</span><textarea rows={3} value={value.anchors} onChange={e => set("anchors",e.target.value)} placeholder={"0.5, 1\n2.5, 5"}/></label>
+            <p>Seconds, beat number. Use at least two anchors; beat 1 is the first downbeat.</p>
+            <label className="rhythm-field"><span>Time-signature changes</span><textarea rows={2} value={value.meter_changes} onChange={e => set("meter_changes",e.target.value)} placeholder="9, 3/4" /></label>
+            <p>Bar number, signature. Bar 1 starts at the first downbeat.</p>
+          </div>
+        </details>
+        {onApply && <label className="rhythm-check rhythm-click"><input type="checkbox" checked={click} onChange={e => onClickChange(e.target.checked)} /><span>Click preview</span></label>}
+        {onApply && dirty && <button type="button" className="rhythm-apply" onClick={onApply}>Apply changes</button>}
+      </div>
+    </fieldset>
+    {dirty && <p role="status" className="rhythm-note">Apply changes to update playback and export.</p>}
+    {summary && !dirty && <p role="status" className="rhythm-result">{summary}</p>}
+    {error && <p role="alert" className="rhythm-warning">{error}</p>}
+    {!dirty && warnings?.map((w,i) => <p key={i} className="rhythm-warning">{w}</p>)}
+  </section>;
+}
