+// A single local recovery session. Never sent anywhere except the local engine.
+export type SavedSession = {
+  format: string; version: number; name: string; timing: Record<string, unknown>;
+  audio?: string | null; audio_name?: string;
+  recovery_saved_at?: number;
+  [key: string]: unknown;
+};
+async function database(): Promise<IDBDatabase> {
+  return new Promise((resolve, reject) => {
+    const request = indexedDB.open('muscriptor-local', 1);
+    request.onupgradeneeded = () => request.result.createObjectStore('recovery');
+    request.onsuccess = () => resolve(request.result);
+    request.onerror = () => reject(request.error);
+  });
+}
+export async function saveRecovery(project: SavedSession): Promise<void> {
+  const saved = {...project, recovery_saved_at: Date.now()};
+  let diskSaved = false;
+  try {
+    const response = await fetch('/session/recovery',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(saved)});
+    diskSaved = response.ok;
+  } catch { /* Keep recovery available if the engine has disconnected. */ }
+  if (diskSaved) {
+    // An older browser fallback must not reappear if the engine later goes offline.
+    try {
+      const db = await database();
+      try { await new Promise<void>((resolve,reject) => {
+        const tx = db.transaction('recovery','readwrite');
+        const store = tx.objectStore('recovery');
+        const existing = store.get('latest');
+        existing.onsuccess = () => {
+          const stamp = existing.result?.recovery_saved_at;
+          if (typeof stamp !== 'number' || !Number.isFinite(stamp) || stamp <= saved.recovery_saved_at) store.delete('latest');
+        };
+        tx.oncomplete = () => resolve();
+        tx.onerror = tx.onabort = () => reject(tx.error);
+      }); } finally { db.close(); }
+    } catch { /* The disk copy is already safe, even if browser storage is denied. */ }
+    return;
+  }
+  // Browser storage still protects refreshes when running without the desktop wrapper.
+  const db = await database();
+  try { await new Promise<void>((resolve,reject) => {
+    const tx = db.transaction('recovery','readwrite');
+    tx.objectStore('recovery').put(saved,'latest');
+    tx.oncomplete = () => resolve();
+    tx.onerror = () => reject(tx.error); tx.onabort = () => reject(tx.error);
+  }); } finally { db.close(); }
+}
+export async function hasSavedRecovery(): Promise<boolean> {
+  try { const r=await fetch('/session/recovery/status'); if(r.ok && (await r.json()).available) return true; } catch { /* browser fallback */ }
+  const db=await database();
+  try { return await new Promise((resolve,reject) => {
+    const request=db.transaction('recovery').objectStore('recovery').count('latest');
+    request.onsuccess=()=>resolve(request.result>0); request.onerror=()=>reject(request.error);
+  }); } finally {db.close();}
+}
+export async function readRecovery(): Promise<SavedSession | undefined> {
+  let disk: SavedSession | undefined;
+  try {
+    const response = await fetch('/session/recovery');
+    if(response.ok) disk = await response.json();
+  } catch { /* Browser fallback. */ }
+  let browser: SavedSession | undefined;
+  try {
+    const db = await database();
+    try { browser = await new Promise((resolve,reject) => {
+      const req = db.transaction('recovery').objectStore('recovery').get('latest');
+      req.onsuccess = () => resolve(req.result); req.onerror = () => reject(req.error);
+    }); } finally { db.close(); }
+  } catch { /* A readable disk recovery remains usable without browser storage. */ }
+  const savedAt = (project: SavedSession) => typeof project.recovery_saved_at === 'number'
+    && Number.isFinite(project.recovery_saved_at) ? project.recovery_saved_at : 0;
+  if (!disk) return browser;
+  return browser && savedAt(browser) > savedAt(disk) ? browser : disk;
+}
+export async function encodeAudio(file: File): Promise<string> {
+  return new Promise((resolve,reject) => {
+    const reader = new FileReader();
+    reader.onload = () => resolve(String(reader.result).split(',')[1]);
+    reader.onerror = () => reject(reader.error); reader.readAsDataURL(file);
+  });
+}
