@@ -0,0 +1,134 @@
+"""Versioned, data-only local projects shared by desktop and browser."""
+import base64
+import io
+import json
+import math
+import os
+from pathlib import Path
+import tempfile
+import time
+
+import mido
+from .rhythm import Detection, RhythmError, Timeline
+
+MAX_BYTES = 256 * 1024 * 1024
+
+
+def decode(value, limit=MAX_BYTES):
+    if not isinstance(value, str) or len(value) > limit * 4 // 3 + 4:
+        raise RhythmError('Session data is missing or too large.')
+    try:
+        return base64.b64decode(value, validate=True)
+    except (ValueError, TypeError):
+        raise RhythmError('Session contains invalid encoded data.') from None
+
+
+def validate(project):
+    if not isinstance(project, dict) or project.get('format') != 'muscriptor-local' or project.get('version') != 1:
+        raise RhythmError('This is not a supported MuScriptor Local session.')
+    raw = decode(project.get('midi'), 16 * 1024 * 1024)
+    try:
+        midi = mido.MidiFile(file=io.BytesIO(raw))
+        if midi.type == 2 or midi.ticks_per_beat <= 0:
+            raise ValueError()
+        # Sessions store the original constant-tempo performance, never an
+        # already quantized result. Rendering relies on this invariant.
+        if any(m.type == 'set_tempo' and m.tempo != 500000 for t in midi.tracks for m in t):
+            raise ValueError()
+    except Exception:
+        raise RhythmError('Session has an invalid original MIDI performance.') from None
+    duration = project.get('duration')
+    if isinstance(duration, bool) or not isinstance(duration, (float, int)) or not math.isfinite(duration) or not 0 < duration <= 86400:
+        raise RhythmError('Session duration is invalid.')
+    detection = project.get('detection', {})
+    if not isinstance(detection, dict):
+        raise RhythmError('Session beat information is invalid.')
+    arrays = []
+    for name in ('beats', 'downbeats'):
+        values = detection.get(name, [])
+        if not isinstance(values, list) or len(values) > 200000:
+            raise RhythmError('Session beat information is too large.')
+        previous = -1
+        for v in values:
+            if isinstance(v, bool) or not isinstance(v, (int, float)) or not math.isfinite(v) or v < 0 or v > duration + 1 or v <= previous:
+                raise RhythmError('Session beats must be increasing times within the recording.')
+            previous = v
+        arrays.append(values)
+    if len(arrays[0]) == 1 or (arrays[1] and not arrays[0]):
+        raise RhythmError('Session beat information is incomplete.')
+    warning = detection.get('warning', '')
+    if not isinstance(warning, str) or len(warning) > 4000:
+        raise RhythmError('Session warning is invalid.')
+    pulse_verified = detection.get('pulse_verified', False)
+    if type(pulse_verified) is not bool:
+        raise RhythmError('Session pulse verification is invalid.')
+    segments = detection.get('meter_segments', [])
+    if not isinstance(segments, list) or len(segments) > 256:
+        raise RhythmError('Session meter suggestions are invalid.')
+    previous = -1
+    for segment in segments:
+        if not isinstance(segment, list) or len(segment) != 4:
+            raise RhythmError('Session meter suggestions are invalid.')
+        second, n, denominator, groups = segment
+        if (isinstance(second, bool) or not isinstance(second, (int, float))
+                or not math.isfinite(second) or second < 0 or not previous < second <= duration
+                or type(n) is not int or not 1 <= n <= 32
+                or type(denominator) is not int or denominator not in (4, 8)
+                or not isinstance(groups, list) or not groups
+                or any(type(g) is not int or not 1 <= g <= 32 for g in groups) or sum(groups) != n):
+            raise RhythmError('Session meter suggestions are invalid.')
+        previous = second
+    if segments and (len(arrays[0]) < 2 or not arrays[1]):
+        raise RhythmError('Session meter suggestions need a beat grid.')
+    d = Detection(*arrays, warning, pulse_verified, segments)
+    settings = project.get('timing', {})
+    Timeline(settings, d, duration)
+    audio = decode(project.get('audio')) if project.get('audio') else None
+    name = str(project.get('name', 'Recording'))[:240].replace('\\', '/').split('/')[-1] or 'Recording'
+    audio_name = str(project.get('audio_name', 'recording.wav')).replace('\\', '/').split('/')[-1]
+    return raw, d, duration, settings, audio, name, audio_name
+
+
+def make(raw, detection, duration, timing, name, audio=None, audio_name='recording.wav'):
+    project = dict(format='muscriptor-local', version=1,
+                   midi=base64.b64encode(raw).decode(), detection=detection.__dict__,
+                   duration=duration, timing=timing, name=Path(name).name,
+                   audio=base64.b64encode(audio).decode() if audio else None, audio_name=audio_name)
+    validate(project)
+    return project
+
+
+def read(path):
+    if Path(path).stat().st_size > MAX_BYTES:
+        raise RhythmError('This session is too large (maximum 256 MB).')
+    try:
+        project = json.loads(Path(path).read_text(encoding='utf-8'))
+    except (ValueError, UnicodeError):
+        raise RhythmError('This session could not be read.') from None
+    validate(project)
+    return project
+
+
+def write(path, project):
+    validate(project)
+    data = json.dumps(project, ensure_ascii=False).encode('utf-8')
+    if len(data) > MAX_BYTES:
+        raise RhythmError('Session exceeds 256 MB. Save a shorter recording as a session.')
+    path = Path(path)
+    path.parent.mkdir(parents=True, exist_ok=True)
+    fd, temp = tempfile.mkstemp(prefix='.session-', dir=path.parent)
+    try:
+        with os.fdopen(fd, 'wb') as f:
+            f.write(data)
+            f.flush()
+            os.fsync(f.fileno())
+        os.replace(temp, path)
+    finally:
+        if os.path.exists(temp):
+            os.unlink(temp)
+
+
+def write_recovery(path, project):
+    # Shared by desktop and web, so browser fallback recovery can be compared
+    # with subsequent desktop saves rather than always preferring the disk.
+    write(path, {**project, 'recovery_saved_at': time.time_ns() // 1_000_000})
