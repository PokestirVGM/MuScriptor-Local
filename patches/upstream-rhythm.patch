index 0000000..38f5365
--- /dev/null
+++ b/muscriptor/utils/rhythm_evidence.py
@@ -0,0 +1,147 @@
+"""Conservative percussion/accent evidence for ambiguous neural beat grids.
+
+A repeated accent is a meter *suggestion*, not proof of written notation.
+No model download, source separation, or changes to audio/note timing.
+"""
+import numpy as np
+
+
+def onset_bands(signal, sr):
+    """Bounded-memory spectral flux, with independent bass and cymbal bands."""
+    hop = max(1, round(sr*.005))
+    size = 2**int(np.ceil(np.log2(sr*.064)))
+    frames = np.lib.stride_tricks.sliding_window_view(np.pad(signal, (size//2, size//2)), size)[::hop]
+    frequencies = np.fft.rfftfreq(size, 1/sr)
+    bands = [(frequencies >= 35) & (frequencies <= 160),
+             (frequencies >= 1500) & (frequencies <= min(7000, sr/2))]
+    window = np.hanning(size)
+    energy = []
+    for start in range(0, len(frames), 512):
+        spectrum = abs(np.fft.rfft(frames[start:start+512]*window, axis=1))
+        energy.append(np.stack([spectrum[:, band].sum(axis=1) for band in bands], axis=1))
+    flux = np.maximum(0., np.diff(np.concatenate(energy), axis=0, prepend=np.zeros((1, 2))))
+    result = []
+    for band in range(2):
+        values = flux[:, band]
+        peaks = np.flatnonzero((values[1:-1] > values[:-2]) & (values[1:-1] >= values[2:]))+1
+        blocked = np.zeros(len(values), dtype=bool)
+        selected = []
+        radius, neighborhood = max(1, round(.08*sr/hop)), max(1, round(sr/hop))
+        for i in peaks[np.argsort(values[peaks])[::-1]]:
+            if blocked[i] or values[i] < max(1e-4, .2*np.max(values[max(0, i-neighborhood):i+neighborhood+1])):
+                continue
+            selected.append(i)
+            blocked[max(0, i-radius):i+radius+1] = True
+        selected = np.asarray(sorted(selected), dtype=int)
+        result.append((selected*hop/sr, values[selected]))
+    return result
+
+
+def percussion_meter(signal, sr, neural_beats, neural_downbeats=None):
+    """Accept only repeated bars with clear accents and independent subdivisions.
+
+    Each section needs four consecutive matching bars, the whole recording at
+    least six. Irregular fills, sparse/crossing cues and ambiguous accents cause
+    rejection, retaining the neural result. Unequal 2/3 groups represent odd
+    meter, not alternating tempos. Covers changing meters only when every
+    section has sufficient repeated evidence.
+    """
+    (low, strength), (high, _) = onset_bands(signal, sr)
+    if len(low) < 16 or len(high) < 24 or len(neural_beats) < 8:
+        return None
+    # Relative strengths tolerate slow gain changes without treating every hit
+    # as a downbeat. Require a clearly separated accent population.
+    normalized = np.array([v/max(np.quantile(strength[max(0,i-12):i+13], .9), 1e-8)
+                           for i, v in enumerate(strength)])
+    accented = normalized >= .88
+    if not .1 <= np.mean(accented) <= .55:
+        return None
+    if np.quantile(normalized[accented], .1) < 1.18*np.quantile(normalized[~accented], .9):
+        return None
+    accents = np.flatnonzero(accented)
+    if len(accents) < 7 or accents[0] > 1 or len(low)-1-accents[-1] > accents[-1]-accents[-2]:
+        return None
+    bars = []
+    for a, b in zip(accents[:-1], accents[1:]):
+        start, end = low[a], low[b]
+        # Align the independently detected high-band grid to these accents.
+        ia, ib = int(np.argmin(abs(high-start))), int(np.argmin(abs(high-end)))
+        if max(abs(high[ia]-start), abs(high[ib]-end)) > .03 or ib <= ia:
+            return None
+        subdivisions = np.diff(high[ia:ib+1])
+        if np.min(subdivisions) < .10 or np.max(subdivisions) > .6:
+            return None
+        hits = low[a:b+1]
+        fractions = (hits-start)/(end-start)
+        uniform = np.max(abs(subdivisions/np.median(subdivisions)-1)) <= .08
+        subdivision = (end-start)/len(subdivisions)
+        groups = np.diff(np.rint((hits-start)/subdivision).astype(int)) if uniform else None
+        if uniform and np.max(abs((hits-start)/subdivision-np.rint((hits-start)/subdivision))) <= .08:
+            if len(groups) in (2, 3, 4, 5, 7) and np.all(groups == 2):
+                n, d, click = len(groups), 4, [1]*len(groups)
+            elif len(groups) in (2, 3, 4) and np.all(groups == 3):
+                n, d, click = 3*len(groups), 8, groups.tolist()
+            elif 2 <= len(groups) <= 5 and set(groups) == {2, 3} and sum(groups) % 2:
+                n, d, click = int(sum(groups)), 8, groups.tolist()
+            else:
+                return None
+        else:
+            # Swing has two unequal subdivisions per *equal* primary beat.
+            count = len(hits)-1
+            if count not in (2, 3, 4, 5, 7) or len(subdivisions) != count*2:
+                return None
+            if np.max(abs(fractions-np.linspace(0,1,count+1))) > .025:
+                return None
+            pairs = subdivisions.reshape(-1,2)
+            ratios = pairs[:,0]/pairs.sum(axis=1)
+            if not np.all((ratios >= .57) & (ratios <= .73)):
+                return None
+            n, d, click = count, 4, [1]*count
+        bars.append((start, end, n, d, click))
+    # A section change is accepted only after sustained evidence on both sides.
+    patterns = [(n,d,tuple(groups)) for _,_,n,d,groups in bars]
+    cuts = [0]+[i for i in range(1,len(bars)) if patterns[i]!=patterns[i-1]]+[len(bars)]
+    if len(cuts) > 257 or any(b-a < 4 for a,b in zip(cuts[:-1],cuts[1:])):
+        return None
+    # The proposal must overlap the model's track and have a simple rhythmic
+    # relationship to it; accent-only detections in a different passage cannot
+    # replace a full recording's beat grid.
+    if low[0] > neural_beats[0]+1.5 or low[-1] < neural_beats[-1]-1.5:
+        return None
+    periods = np.array([(end-start)/(n*4/d) for start,end,n,d,_ in bars])
+    if np.any((periods < .15) | (periods > 1.5)):
+        return None
+    ratios = np.median(np.diff(neural_beats))/periods
+    agreement = np.min(abs(ratios[:, None]/np.array([.5, 2/3, 1., 1.5, 2.])-1), axis=1)
+    if np.mean(agreement <= .10) < .25:
+        return None
+    # A regular backbeat can look like a shorter bar. Preserve a consistent
+    # model bar interpretation when the quarter pulse already agrees and the
+    # proposed accent bars are exactly half as long. Accent strength alone
+    # does not establish that a snare hit is the written downbeat.
+    if neural_downbeats is not None and len(neural_downbeats) >= 7:
+        model_beats = np.asarray(neural_beats)
+        model_downs = np.asarray(neural_downbeats)
+        positions = np.searchsorted(model_beats, model_downs).clip(0, len(model_beats)-1)
+        left = np.maximum(positions-1, 0)
+        positions = np.where(abs(model_beats[left]-model_downs) < abs(model_beats[positions]-model_downs), left, positions)
+        counts = np.diff(positions)
+        model_count = int(np.median(counts))
+        pulse_agrees = abs(np.median(np.diff(model_beats))/np.median(periods)-1) <= .08
+        if (pulse_agrees and model_count >= 2 and np.mean(counts == model_count) >= .9
+                and np.max(abs(model_beats[positions]-model_downs)) <= .03
+                and all(abs(n*4/d*2-model_count) < .01 for _,_,n,d,_ in bars)):
+            return None
+    # Construct a regular quarter lattice within each evidenced bar, keeping
+    # odd-meter fractional bar positions. Do not feed unequal group intervals
+    # to a tempo estimator as if each were the same musical duration.
+    q = np.r_[0.,np.cumsum([n*4/d for _,_,n,d,_ in bars])]
+    times = np.array([bars[0][0]]+[b[1] for b in bars])
+    tail = low[-1]-times[-1]
+    final_q = q[-1]+tail/periods[-1]
+    quarters = np.arange(0,final_q+1e-8)
+    beats = np.interp(quarters,q,times)
+    beyond = quarters > q[-1]
+    beats[beyond] = times[-1]+(quarters[beyond]-q[-1])*periods[-1]
+    segments = [[float(bars[i][0]),bars[i][2],bars[i][3],bars[i][4]] for i in cuts[:-1]]
+    return dict(beats=beats.tolist(),downbeats=low[accents].tolist(),meter_segments=segments)
