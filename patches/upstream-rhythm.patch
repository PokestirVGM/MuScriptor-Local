+++ b/muscriptor/utils/rhythm.py
@@ -0,0 +1,711 @@
+"""Local rhythm editing. Source seconds, musical quarters, and export seconds
+are separate coordinates. Detection never quantizes or moves a note.
+"""
+from __future__ import annotations
+
+import base64
+import io
+import logging
+import math
+from collections import deque
+from dataclasses import dataclass, field
+
+import mido
+import numpy as np
+
+
+class RhythmError(ValueError):
+    pass
+
+
+def number(value, name, low, high):
+    if isinstance(value, bool):
+        raise RhythmError(f"{name} must be a number.")
+    try:
+        value = float(value)
+    except (TypeError, ValueError):
+        raise RhythmError(f"Enter {name}.") from None
+    if not math.isfinite(value) or not low <= value <= high:
+        raise RhythmError(f"{name} must be between {low:g} and {high:g}.")
+    return value
+
+
+def signature(value):
+    try:
+        n, d = str(value).split('/')
+        n, d = int(n), int(d)
+    except (ValueError, TypeError):
+        raise RhythmError("Enter a time signature such as 4/4 or 6/8.") from None
+    if not 1 <= n <= 32 or d not in (1, 2, 4, 8, 16, 32):
+        raise RhythmError("Use 1–32 beats and a denominator of 1, 2, 4, 8, 16, or 32.")
+    return n, d
+
+
+def meter_unit(meter):
+    return 1.5 if meter and meter[1] == 8 and meter[0] >= 6 and meter[0] % 3 == 0 else 1.
+
+
+def options(value=None):
+    if value is not None and not isinstance(value, dict):
+        raise RhythmError("Timing settings must be an object.")
+    v = dict(value or {})
+    mode = v.get('mode', 'auto')
+    if mode not in ('auto', 'manual'):
+        raise RhythmError("Choose Auto or Manual tempo.")
+    meter = v.get('meter', 'auto')
+    if meter != 'auto':
+        signature(meter)
+    unit = v.get('unit', 'auto')
+    if unit not in ('auto', 'quarter', 'dotted-quarter', 'eighth'):
+        raise RhythmError("Choose a valid BPM beat unit.")
+    if v.get('stretch', False):
+        raise RhythmError("Changing playback speed is not supported. Manual BPM only defines the grid.")
+    quantize = v.get('quantize', False)
+    if type(quantize) is not bool:
+        raise RhythmError("Quantize must be on or off.")
+    subdivision = str(v.get('subdivision', 'auto'))
+    if subdivision not in ('auto', '2', '4', '3'):
+        raise RhythmError("Choose Auto, eighth notes, sixteenth notes, or triplets.")
+    anchors = v.get('anchors', [])
+    # Text form is shared by compact desktop controls. Each line is seconds, beat.
+    if isinstance(anchors, str):
+        try:
+            anchors = [list(map(float, line.split(','))) for line in anchors.splitlines() if line.strip()]
+        except ValueError:
+            raise RhythmError("Anchors use one ‘seconds, beat number’ pair per line.") from None
+    if not isinstance(anchors, list) or len(anchors) > 256:
+        raise RhythmError("Use at most 256 beat anchors.")
+    parsed = []
+    for anchor in anchors:
+        if not isinstance(anchor, (list, tuple)) or len(anchor) != 2:
+            raise RhythmError("Each anchor needs seconds and a beat number (starting at 1).")
+        parsed.append([number(anchor[0], 'Anchor seconds', 0, 86400), number(anchor[1], 'Anchor beat', 1, 1000000)])
+    if len(parsed) == 1 or any(b[0] <= a[0] or b[1] <= a[1] for a, b in zip(parsed, parsed[1:])):
+        raise RhythmError("Use at least two anchors, with increasing seconds and beat numbers.")
+    changes = v.get('meter_changes', '')
+    parsed_changes = []
+    if not isinstance(changes, str):
+        raise RhythmError("Meter changes use ‘bar number, signature’, one per line.")
+    for line in changes.splitlines():
+        if not line.strip():
+            continue
+        try:
+            bar, sig = line.split(',')
+            bar = int(bar.strip())
+        except ValueError:
+            raise RhythmError("Meter changes use ‘bar number, signature’, for example ‘9, 3/4’.") from None
+        n, d = signature(sig.strip())
+        if bar < 2 or bar > 100000 or (parsed_changes and bar <= parsed_changes[-1][0]):
+            raise RhythmError("Meter changes must have increasing bar numbers, starting at bar 2.")
+        parsed_changes.append((bar, n, d))
+    factor = number(v.get('factor', 1), 'Tempo interpretation', 0.5, 2)
+    if factor not in (0.5, 1, 2):
+        raise RhythmError("Choose half, normal, or double tempo.")
+    return dict(mode=mode, meter=meter, unit=unit, quantize=quantize,
+                bpm=number(v.get('bpm', 120), 'BPM', 10, 600),
+                first_downbeat=number(v.get('first_downbeat', 0), 'First downbeat seconds', 0, 86400),
+                subdivision=subdivision, anchors=parsed, meter_changes=parsed_changes, factor=factor)
+
+
+@dataclass
+class Detection:
+    beats: list[float]
+    downbeats: list[float]
+    warning: str = ''
+    pulse_verified: bool = False
+    meter_segments: list = field(default_factory=list)
+
+
+def clean_isolated_beats(beats, downbeats):
+    """Remove only isolated split intervals supported by normal neighbors.
+
+    Never bridge gaps or flatten a sustained tempo change. Kept timestamps
+    remain the detector's timestamps; ambiguous passages remain flagged.
+    """
+    beats = np.asarray(beats, dtype=float)
+    downbeats = np.asarray(downbeats, dtype=float)
+    removed = 0
+    for _ in range(2):
+        keep = np.ones(len(beats), dtype=bool)
+        intervals = np.diff(beats)
+        i = 2
+        while i < len(beats)-2:
+            before, left, right, after = intervals[i-2:i+2]
+            local = float(np.median(intervals[max(0,i-10):min(len(intervals),i+10)]))
+            neighbor_agreement = abs(before-local) < .18*local and abs(after-local) < .18*local
+            split = min(left,right) < .65*local and abs(left+right-local) < .15*local
+            if neighbor_agreement and split:
+                keep[i] = False
+                removed += 1
+                i += 3
+            else:
+                i += 1
+        if keep.all():
+            break
+        beats = beats[keep]
+    if removed:
+        logging.info('Discarded %d isolated extra beat detections', removed)
+        downbeats = np.array([d for d in downbeats if len(beats) and np.min(abs(beats-d)) < .025])
+    return beats, downbeats
+
+
+def audio_pulse_candidate(signal, sr, beats):
+    """Conservative recovery for a clear, continuous bass/percussion pulse.
+
+    This is not a second general-purpose beat tracker. Require nearly every
+    attack interval to have local support, and a run of eight model beats to
+    match one-for-one. Syncopated/sparse/ambiguous attack trains are rejected.
+    Process FFTs in bounded batches, even for long recordings.
+    """
+    hop = max(1, round(sr*.005))
+    size = 2**int(np.ceil(np.log2(sr*.064)))
+    frames = np.lib.stride_tricks.sliding_window_view(
+        np.pad(signal, (size//2, size//2)), size)[::hop]
+    frequencies = np.fft.rfftfreq(size, 1/sr)
+    band = (frequencies >= 35) & (frequencies <= 250)
+    window = np.hanning(size)
+    energy = np.concatenate([
+        abs(np.fft.rfft(frames[i:i+512]*window, axis=1))[:, band].sum(axis=1)
+        for i in range(0, len(frames), 512)])
+    flux = np.maximum(0., np.diff(energy, prepend=energy[0]))
+    peaks = np.flatnonzero((flux[1:-1] > flux[:-2]) & (flux[1:-1] >= flux[2:]))+1
+    # Suppress closely spaced attacks without an O(number_of_peaks**2) scan.
+    blocked = np.zeros(len(flux), dtype=bool)
+    radius = int(np.floor(.100*sr/hop))
+    neighborhood = max(1, round(sr/hop))
+    selected = []
+    for i in peaks[np.argsort(flux[peaks])[::-1]]:
+        if blocked[i]:
+            continue
+        local = flux[max(0, i-neighborhood):i+neighborhood+1]
+        if flux[i] < max(1e-4, .28*float(np.max(local))):
+            continue
+        selected.append(i)
+        blocked[max(0, i-radius):i+radius+1] = True
+    attacks = np.asarray(sorted(selected))*hop/sr
+    if len(attacks) < 16:
+        return None
+    intervals = np.diff(attacks)
+    if np.any(intervals < .2) or np.any(intervals > 1.5):
+        return None
+    supported = [abs(v/np.median(intervals[max(0, i-2):i+3])-1) <= .06
+                 for i, v in enumerate(intervals)]
+    if np.mean(supported) < .98:
+        return None
+    # Cover the model's track, allowing its first/last extrapolated beat to
+    # fall outside the actual attacks. Find a supported pulse run anywhere:
+    # an unreliable introduction must not veto a clear later agreement.
+    if (attacks[0] > beats[0]+1.25*intervals[0]
+            or attacks[-1] < beats[-1]-1.25*intervals[-1]):
+        return None
+    positions = np.searchsorted(beats, attacks).clip(0, len(beats)-1)
+    left = np.maximum(0, positions-1)
+    positions = np.where(abs(beats[left]-attacks) < abs(beats[positions]-attacks), left, positions)
+    close = abs(beats[positions]-attacks) <= .035
+    run = 0
+    for i, matched in enumerate(close):
+        run = (run+1 if i and positions[i]-positions[i-1] == 1 else 1) if matched else 0
+        if run >= 8:
+            break
+    else:
+        return None  # A subdivision/half-time attack train is not confirmation.
+    return attacks
+
+
+def stable_tempo_map(beats, pulse_verified=False):
+    """Fit a sparse tempo map, rather than exporting detector interval jitter.
+
+    Reliable runs need at least eight beats. Noisy passages are bridged with an
+    estimated grid, and disclosed. Median local line estimates suppress timing
+    jitter; a 60 ms approximation budget reduces them to a few linear sections.
+    This tolerance applies to the estimated GRID, never to note playback times.
+    """
+    beats, _ = clean_isolated_beats(beats, [])
+    intervals = np.diff(beats)
+
+    def fallback():
+        period = float(np.median(intervals))
+        return beats[[0, -1]], np.array([0., (beats[-1]-beats[0])/period]), True
+
+    if len(beats) < 9:
+        return fallback()
+    confidence = []
+    for i in range(len(beats)):
+        # Either side may support a beat: an abrupt, sustained change should
+        # not be rejected merely because the two sides have different tempos.
+        sides = [intervals[max(0, i-6):i], intervals[i:i+6]]
+        scores = [np.mean(abs(side-np.median(side)) <= .18*np.median(side))
+                  for side in sides if len(side) >= 4]
+        confidence.append(max(scores, default=0))
+    reliable = np.asarray(confidence) >= .8
+    starts = np.flatnonzero(reliable & ~np.r_[False, reliable[:-1]])
+    ends = np.flatnonzero(reliable & ~np.r_[reliable[1:], False]) + 1
+    for start, end in zip(starts, ends):
+        if end-start < 8:
+            reliable[start:end] = False
+        else:
+            # Keep uncertain transition edges out of the local slope estimate.
+            if start > 0:
+                reliable[start:start+3] = False
+            if end < len(beats):
+                reliable[end-3:end] = False
+    if reliable.sum() < 8:
+        return fallback()
+    times = beats[reliable]
+    original_indices = np.flatnonzero(reliable)
+    cuts = np.r_[0, np.flatnonzero(np.diff(original_indices) > 1)+1, len(times)]
+    periods = np.empty(len(times))
+    for start, end in zip(cuts[:-1], cuts[1:]):
+        for i in range(start, end):
+            periods[i] = np.median(np.diff(times[max(start, i-6):min(end, i+7)]))
+    increments = np.where(np.diff(original_indices) == 1, 1,
+                          np.maximum(1, np.round(np.diff(times)/((periods[:-1]+periods[1:])/2))))
+    # Repair isolated missed beats only when both surrounding tempos agree.
+    for i, gap in enumerate(np.diff(times)):
+        left = np.diff(times[max(0, i-4):i+1])
+        right = np.diff(times[i+1:i+6])
+        if len(left) < 2 or len(right) < 2:
+            continue
+        a, b = np.median(left), np.median(right)
+        period = (a+b)/2
+        multiple = round(gap/period)
+        if (abs(a-b) < .15*period and 2 <= multiple <= 4
+                and abs(gap-multiple*period) < .15*period):
+            increments[i] = multiple
+    counts = np.r_[0, np.cumsum(increments)]
+    smoothed = []
+    for i in range(len(times)):
+        run = np.searchsorted(cuts, i, side='right')-1
+        lo, hi = max(cuts[run], i-4), min(cuts[run+1], i+5)
+        x, t = counts[lo:hi], times[lo:hi]
+        slope = np.median(np.diff(t)/np.diff(x))
+        left = np.diff(times[max(cuts[run], i-4):i+1])
+        right = np.diff(times[i:min(cuts[run+1], i+5)])
+        if (len(left) >= 2 and len(right) >= 2
+                and abs(np.median(left)-np.median(right)) > .12*max(np.median(left), np.median(right))):
+            smoothed.append(times[i])  # Preserve corners at real tempo changes.
+        else:
+            smoothed.append(np.median(t-slope*(x-counts[i])))
+    # Independently supported audio attacks have 5 ms resolution. Preserve
+    # their curvature/corners: the wider median smoother can lag accelerando.
+    smoothed = times if pulse_verified else np.asarray(smoothed)
+    if np.any(np.diff(smoothed) <= 0):
+        return fallback()
+    keep, stack = {0, len(times)-1}, [(0, len(times)-1)]
+    while stack:
+        lo, hi = stack.pop()
+        if hi-lo < 2:
+            continue
+        fitted = np.interp(counts[lo:hi+1], counts[[lo, hi]], smoothed[[lo, hi]])
+        error = abs(smoothed[lo:hi+1]-fitted)
+        split = int(np.argmax(error))+lo
+        if error[split-lo] > (.012 if pulse_verified else .060):
+            keep.add(split)
+            stack.extend([(lo, split), (split, hi)])
+    keep = sorted(keep)
+    return smoothed[keep], counts[keep], not reliable.all()
+
+
+def detect(wav, sr):
+    """Preserve variable beats; detector errors are disclosed, never guessed away."""
+    try:
+        from beat_this.inference import Audio2Beats
+        signal = wav.detach().cpu().numpy()
+        if signal.ndim > 1:
+            signal = signal.mean(axis=0)
+        if len(signal) < sr:
+            raise RhythmError("Recording is too short for automatic beat detection.")
+        beats, downbeats = Audio2Beats(checkpoint_path='final0', device='cpu', dbn=False)(signal, sr)
+        beats = np.asarray(beats, dtype=float)
+        if len(beats) < 8 or not np.isfinite(beats).all() or np.any(np.diff(beats) <= 0):
+            raise RhythmError("Not enough reliable beats were detected.")
+        beats, downbeats = clean_isolated_beats(beats, downbeats)
+        pulse_verified = False
+        # Audio verification is optional. A failed verification must never
+        # discard otherwise usable neural detections.
+        try:
+            candidate = audio_pulse_candidate(signal, sr, beats)
+            if candidate is not None:
+                x, q, _ = stable_tempo_map(beats)
+                grid = interp(np.arange(np.ceil(q[0]), np.floor(q[-1])+1), q, x)
+                positions = np.searchsorted(grid, candidate).clip(0, len(grid)-1)
+                distance = np.minimum(abs(grid[positions]-candidate), abs(grid[np.maximum(0, positions-1)]-candidate))
+                # Leave already aligned detections alone. Recovery requires
+                # a sustained disagreement, not isolated attack jitter.
+                if np.mean(distance > .045) >= .15:
+                    beats = candidate
+                    # The neural downbeats belong to the rejected grid. Do not
+                    # turn them into a fabricated meter for the replacement.
+                    downbeats = np.array([])
+                    pulse_verified = True
+        except Exception:
+            logging.exception('Optional audio pulse verification unavailable')
+        try:
+            from .rhythm_evidence import percussion_meter
+            evidence = percussion_meter(signal, sr, beats, downbeats)
+            if evidence is not None:
+                return Detection(**evidence, pulse_verified=True,
+                    warning='Auto used repeated percussion accents and subdivisions to suggest the beat grid and meter. Check the click preview, especially at meter changes; musical notation can still be ambiguous.')
+        except Exception:
+            logging.exception('Optional percussion meter evidence unavailable')
+        intervals = np.diff(beats)
+        if np.any(intervals < .06) or np.any(intervals > 6):
+            raise RhythmError("Beat tracking contains implausible gaps; set manual anchors.")
+        downs = np.asarray(downbeats, dtype=float)
+        downs = downs[np.isfinite(downs) & (downs >= beats[0]) & (downs <= beats[-1])]
+        warning = ''
+        if len(intervals) > 2 and np.any(np.abs(np.log(intervals[1:] / intervals[:-1])) > np.log(1.65)):
+            warning = 'Abrupt beat-spacing changes detected. Check the click preview; missed or extra beats may need manual anchors.'
+        if pulse_verified:
+            warning = 'Auto recovered a clear audio pulse where the beat model drifted. Check the click preview and set the time signature manually.'
+        return Detection(beats.tolist(), downs.tolist(), warning, pulse_verified)
+    except Exception as exc:
+        logging.exception('Rhythm detection unavailable')
+        return Detection([], [], "Tempo could not be detected. Timing is preserved with placeholder 120 BPM. Set a manual tempo or beat anchors to align the grid.")
+
+
+def interp(value, x, y):
+    """Linear map with linear endpoint extrapolation, including pickups/tails."""
+    a = np.asarray(value, dtype=float)
+    result = np.interp(a, x, y)
+    result = np.where(a < x[0], y[0] + (a-x[0]) * (y[1]-y[0])/(x[1]-x[0]), result)
+    result = np.where(a > x[-1], y[-1] + (a-x[-1]) * (y[-1]-y[-2])/(x[-1]-x[-2]), result)
+    return result
+
+
+class Timeline:
+    def __init__(self, settings, detection, duration):
+        self.o = o = options(settings)
+        self.duration = duration
+        if o['mode'] == 'manual' and o['first_downbeat'] > duration:
+            raise RhythmError('The first downbeat must be within the recording.')
+        if o['anchors'] and o['anchors'][-1][0] > duration:
+            raise RhythmError('Beat anchors must be within the recording.')
+        self.warnings = [detection.warning] if detection.warning else []
+        self.meter_inferred = False
+        self.meter = signature(o['meter']) if o['meter'] != 'auto' else None
+        beats = np.asarray(detection.beats, dtype=float)
+        downs = np.asarray(detection.downbeats, dtype=float)
+        if self.meter is None and detection.meter_segments:
+            self.meter = tuple(detection.meter_segments[0][1:3])
+            self.meter_inferred = True
+        if self.meter is None and len(downs) >= 3 and len(beats) >= 2:
+            positions = np.searchsorted(beats, downs)
+            positions = np.minimum(positions, len(beats)-1)
+            left = np.maximum(positions-1, 0)
+            positions = np.where(abs(beats[left]-downs) < abs(beats[positions]-downs), left, positions)
+            counts = np.diff(positions)
+            vals, tally = np.unique(counts, return_counts=True)
+            winner = int(vals[np.argmax(tally)])
+            if 2 <= winner <= 12 and max(tally)/len(counts) >= .9:
+                self.meter = (winner, 4)
+                self.meter_inferred = True
+        if o['meter_changes'] and self.meter is None:
+            raise RhythmError('Choose the starting time signature before adding meter changes.')
+        self.unit = {'quarter': 1., 'dotted-quarter': 1.5, 'eighth': .5}.get(o['unit'])
+        if self.unit is None:
+            self.unit = meter_unit(self.meter)
+        self.unit_name = {1.: 'quarter', 1.5: 'dotted-quarter', .5: 'eighth'}[self.unit]
+        self.detected = len(beats) >= 2
+        first = float(downs[0]) if len(downs) else float(beats[0]) if len(beats) else 0.
+        if o['anchors']:
+            self.x = np.array([a[0] for a in o['anchors']])
+            self.q = np.array([(a[1]-1)*self.unit for a in o['anchors']])
+            first = float(interp(0, self.q, self.x))
+            self.warnings = []  # Explicit anchors replace the detected grid.
+        elif o['mode'] == 'manual':
+            first = o['first_downbeat']
+            self.x = np.array([first, first + 60/o['bpm']])
+            self.q = np.array([0., self.unit])
+            self.warnings = []  # Manual BPM replaces the detected grid.
+        elif self.detected:
+            self.x, pulse, uncertain = stable_tempo_map(beats, detection.pulse_verified)
+            # Percussion evidence carries a quarter-note lattice, independently
+            # of whether the visible BPM uses dotted quarters or eighths.
+            detected_unit = 1. if detection.meter_segments else self.unit
+            self.q = pulse*detected_unit*o['factor']
+            self.q -= float(interp(first, self.x, self.q))
+            # Normalize only a supported constant estimate. Both limits matter:
+            # a tiny BPM difference can still cause substantial drift on a long
+            # recording. This changes musical coordinates, never source seconds.
+            if len(self.x) == 2 and not uncertain:
+                estimated = 60*(self.q[1]-self.q[0])/(self.unit*(self.x[1]-self.x[0]))
+                whole = round(estimated)
+                extent = max(abs(first), abs(duration-first))
+                drift = extent*abs(estimated-whole)/whole if whole > 0 else math.inf
+                if abs(estimated-whole) <= .05 and drift <= .020:
+                    self.q = (self.x-first)*self.unit*whole/60
+            if uncertain:
+                self.warnings = ['Some beat detections were unreliable. Auto approximated those sections instead of exporting tempo spikes. Check the click preview; use manual BPM or anchors to correct the grid.']
+        else:
+            self.x = np.array([0., .5])
+            self.q = np.array([0., 1.])
+            self.unit = 1.
+            self.unit_name = 'quarter'
+        self.usable = self.detected or bool(o['anchors']) or o['mode'] == 'manual'
+        if o['quantize'] and not self.usable:
+            self.warnings.append('Quantization was not applied: no usable beat grid. Original timing was exported.')
+        self.quantized = o['quantize'] and self.usable
+        self.first = first
+        self.periods = np.diff(self.x)/np.diff(self.q)
+        # Summarize the dominant duration, not the number of tempo-map knots.
+        order = np.argsort(self.periods)
+        weights = np.cumsum(np.diff(self.x)[order])
+        typical = self.periods[order[np.searchsorted(weights, weights[-1]/2)]]
+        self.bpm = o['bpm'] if o['mode'] == 'manual' and not o['anchors'] else 60/(self.unit*float(typical))
+        # Audio and MIDI both start at zero. Never prepend silence to align a
+        # bar. A signature event at the first downbeat marks the pickup boundary;
+        # hosts that only allow whole-bar changes may need their own pickup setting.
+        self.shift = -float(self.to_q(0))
+        self.meters = [(0., self.meter)] if self.meter else []
+        first_q = self.shift
+        if self.meter and first_q > 1e-8:
+            # Where possible encode the leading partial measure exactly.
+            for denominator in (4, 8, 16, 32, 64, 128):
+                numerator = first_q * denominator / 4
+                if abs(numerator-round(numerator)) < 1e-7 and 1 <= round(numerator) <= 255:
+                    self.meters[0] = (0., (round(numerator), denominator))
+                    break
+            self.meters.append((first_q, self.meter))
+        previous_bar, previous_q, previous_meter = 1, 0., self.meter
+        for bar_number, n, d in o['meter_changes']:
+            at = previous_q + (bar_number-previous_bar)*previous_meter[0]*4/previous_meter[1]
+            self.meters.append((max(0., at+self.shift), (n, d)))
+            previous_bar, previous_q, previous_meter = bar_number, at, (n, d)
+        self.groupings = []
+        self.meter_changes_inferred = False
+        if (detection.meter_segments and o['mode'] == 'auto' and not o['anchors']
+                and o['meter'] == 'auto' and not o['meter_changes'] and o['factor'] == 1):
+            self.meter_changes_inferred = len(detection.meter_segments) > 1
+            for i, (second, n, d, groups) in enumerate(detection.meter_segments):
+                at = max(0., float(self.to_q(second))+self.shift)
+                if i:
+                    self.meters.append((at, (n, d)))
+                if o['unit'] == 'auto':
+                    self.groupings.append((at, np.asarray(groups)*4/d))
+        self.offset = 0.
+
+    def to_q(self, t):
+        return interp(t, self.x, self.q)
+
+    def seconds_at_q(self, q):
+        return interp(q, self.q, self.x)
+
+    def export_seconds(self, t):
+        return self.seconds_at_q(self.to_q(t)) + self.offset
+
+    def step(self, boundaries):
+        if self.o['subdivision'] != 'auto':
+            return 1/int(self.o['subdivision'])
+        # Releases matter too: quarter-note attacks can have eighth/sixteenth
+        # articulation. Using attacks alone collapses short notes to tiny blips.
+        q = np.asarray(self.to_q(boundaries))
+        if not len(q):
+            return .25
+        for step in (1., .5, 1/3, .25):
+            if np.quantile(abs(q/step-np.round(q/step)), .8) <= .12:
+                return step
+        return .25
+
+    def display_grid(self):
+        end = float(self.to_q(self.duration))
+        start = float(self.to_q(0))
+        quarters = []
+        sections = self.meters or [(0., None)]
+        for i, (at, meter) in enumerate(sections):
+            lower = max(start, at-self.shift)
+            upper = min(end, sections[i+1][0]-self.shift) if i+1 < len(sections) else end
+            unit = meter_unit(meter) if self.o['unit'] == 'auto' and meter else self.unit
+            # A pickup is a partial measure, not a new metronome phase/unit.
+            phase = at-self.shift if i else 0.
+            if i == 0: unit = self.unit
+            grouping = next((g for position, g in reversed(self.groupings) if position <= at+1e-8), None)
+            if grouping is not None:
+                bar = float(sum(grouping))
+                offsets = np.r_[0., np.cumsum(grouping[:-1])]
+                candidates = [q+offset for q in np.arange(phase+math.floor((lower-phase)/bar)*bar, upper+1e-9, bar)
+                              for offset in offsets if lower-1e-9 <= q+offset <= upper+1e-9]
+            else:
+                first = math.ceil((lower-phase)/unit-1e-9)*unit+phase
+                candidates = np.arange(first, upper+1e-9, unit)
+            for q in candidates:
+                if i+1 < len(sections) and q >= upper-1e-9: continue
+                quarters.append(q)
+        times = self.seconds_at_q(np.array(quarters))
+        # Preview and MIDI share the original audio's time origin.
+        origin = float(self.seconds_at_q(start))
+        times = times-origin
+        bars = []
+        for i, (at, meter) in enumerate(self.meters):
+            qstart = at-self.shift
+            stop = self.meters[i+1][0]-self.shift if i+1 < len(self.meters) else end+meter[0]*4/meter[1]
+            bar = meter[0]*4/meter[1]
+            for q in np.arange(qstart, stop-1e-8, bar):
+                t = float(self.seconds_at_q(q))-origin
+                if t >= 0:
+                    bars.append(t)
+        return dict(bpm=self.bpm, beats_per_bar=(self.meter[0]*4/self.meter[1]/self.unit) if self.meter else None,
+                    first_downbeat=float(self.seconds_at_q(0))-origin, onset_delay=0,
+                    beats=times.tolist(), downbeats=bars, unit=self.unit_name,
+                    meter=f'{self.meter[0]}/{self.meter[1]}' if self.meter else None)
+
+
+def render(model, events, detection, settings, duration):
+    timeline = Timeline(settings, detection, duration)
+    raw = model.events_to_midi_bytes(iter(events), beat_grid=None, quantize=False)
+    return retime(raw, timeline)
+
+
+def retime(raw, timeline):
+    """Export the engine's validated notes using the exact same piecewise map as tempo."""
+    source = mido.MidiFile(file=io.BytesIO(raw))
+    ppq = 9600
+    result = mido.MidiFile(type=1, ticks_per_beat=ppq)
+    conductor = mido.MidiTrack()
+    result.tracks.append(conductor)
+    # Serialize the tempo map first: integer microsecond tempos accumulate
+    # rounding error over long recordings. Preserve source seconds using the
+    # actual map a MIDI player will read, not the ideal floating-point BPM.
+    qs = [ -timeline.shift, *[float(q) for q in timeline.q if q > -timeline.shift] ]
+    knots = []
+    for q in qs:
+        index = min(max(int(np.searchsorted(timeline.q, q, side='right'))-1, 0), len(timeline.q)-2)
+        us = round(1000000*(timeline.x[index+1]-timeline.x[index])/(timeline.q[index+1]-timeline.q[index]))
+        if not 1 <= us <= 0xFFFFFF:
+            raise RhythmError('This tempo is outside the MIDI range. Check the beat anchors.')
+        if not knots or us != knots[-1][1]:
+            knots.append((max(0, round((q+timeline.shift)*ppq)), us))
+    knots = list(dict(knots).items())  # Last tempo wins at coincident ticks.
+    knot_ticks = np.array([tick for tick, _ in knots], dtype=float)
+    tick_periods = np.array([us for _, us in knots], dtype=float)/(1000000*ppq)
+    knot_seconds = np.r_[0., np.cumsum(np.diff(knot_ticks)*tick_periods[:-1])]
+
+    def tick_at_seconds(seconds):
+        i = max(0, int(np.searchsorted(knot_seconds, seconds, side='right'))-1)
+        return max(0, round(knot_ticks[i]+(seconds-knot_seconds[i])/tick_periods[i]))
+
+    def seconds_at_tick(tick):
+        i = max(0, int(np.searchsorted(knot_ticks, tick, side='right'))-1)
+        return float(knot_seconds[i]+(tick-knot_ticks[i])*tick_periods[i])
+
+    # Source exporter is deliberately requested with no grid: constant 120 BPM.
+    tracks = []
+    boundaries = []
+    for track in source.tracks:
+        sec = 0.
+        items = []
+        for msg in track:
+            sec += mido.tick2second(msg.time, source.ticks_per_beat, 500000)
+            if msg.type in ('set_tempo', 'time_signature', 'end_of_track', 'marker'):
+                continue
+            items.append((sec, msg))
+            if msg.type in ('note_on', 'note_off'):
+                boundaries.append(sec)
+        tracks.append(items)
+    step = timeline.step(boundaries) if timeline.quantized else None
+    preview = []
+    merged = 0
+    for items in tracks:
+        if not items:
+            continue
+        output = []
+        pending = {}
+        intervals = {}
+        instrument = next((msg.name for _, msg in items if msg.type == 'track_name'), 'piano')
+        for sec, msg in items:
+            if msg.type not in ('note_on', 'note_off'):
+                output.append((tick_at_seconds(sec), msg))
+                continue
+            q = float(timeline.to_q(sec))
+            if step is not None:
+                q = round(q/step)*step
+            tick = max(0, round((q+timeline.shift)*ppq)) if step is not None else tick_at_seconds(sec)
+            key = (msg.channel, msg.note)
+            if msg.type == 'note_on' and msg.velocity:
+                pending.setdefault(key, deque()).append((tick, msg))
+                if step is None: output.append((tick, msg))
+            elif pending.get(key):
+                start, on = pending[key].popleft()
+                tick = max(tick, start+max(1, round(step*ppq)) if step is not None else start+1)
+                intervals.setdefault(key, []).append([start, tick, on, msg])
+                if step is None: output.append((tick, msg))
+            elif step is None:
+                output.append((tick, msg))
+        for notes in intervals.values():
+            cleaned = []
+            for note in sorted(notes, key=lambda n:n[0]):
+                if step is not None and cleaned and note[0] == cleaned[-1][0]:
+                    # Two attacks snapped to one point: one sounding note,
+                    # ending at the later release, rather than a stuck overlap.
+                    cleaned[-1][1] = max(cleaned[-1][1], note[1])
+                    merged += 1
+                    continue
+                if step is not None and cleaned:
+                    cleaned[-1][1] = min(cleaned[-1][1], note[0])
+                cleaned.append(note)
+            for start, end, on, off in cleaned:
+                if step is not None: output.extend(((start, on), (end, off)))
+                preview.append(dict(pitch=on.note,
+                    start=seconds_at_tick(start),
+                    end=seconds_at_tick(end),
+                    instrument=instrument.replace(' ', '_')))
+        if step is None:
+            output.sort(key=lambda item: item[0])  # Preserve simultaneous controller/note ordering.
+        else:
+            output.sort(key=lambda item: (item[0], 0 if item[1].type == 'note_off' or (item[1].type == 'note_on' and not item[1].velocity) else 1))
+        track = mido.MidiTrack()
+        last = 0
+        for tick, msg in output:
+            track.append(msg.copy(time=tick-last))
+            last = tick
+        result.tracks.append(track)
+    metadata = [(tick, mido.MetaMessage('set_tempo', tempo=us)) for tick, us in knots]
+    for q, (n, d) in timeline.meters:
+        click_unit = meter_unit((n, d)) if timeline.o['unit'] == 'auto' else timeline.unit
+        if q == 0: click_unit = timeline.unit
+        metadata.append((round(q*ppq), mido.MetaMessage('time_signature', numerator=n, denominator=d,
+                         clocks_per_click=round(click_unit*24))))
+    if timeline.first > 0:
+        metadata.append((max(0, round(timeline.shift*ppq)), mido.MetaMessage('marker', text=f'First downbeat: {timeline.first:.6f}s')))
+    last = 0
+    for tick, msg in sorted(metadata, key=lambda item: item[0]):
+        conductor.append(msg.copy(time=tick-last))
+        last = tick
+    buffer = io.BytesIO()
+    result.save(file=buffer)
+    grid = timeline.display_grid() if timeline.usable else None
+    variable = np.ptp(timeline.periods) > .015
+    state = 'Original timing'
+    if timeline.quantized:
+        state = 'Notes quantized'
+    summary = f"{timeline.bpm:.1f} BPM{' · ' + timeline.unit_name if timeline.unit_name != 'quarter' else ''} · {grid['meter'] or 'meter uncertain'}{' + meter changes suggested' if timeline.meter_changes_inferred else ' suggested' if timeline.meter_inferred else ''} · {'variable tempo · ' if variable else ''}{state}" if grid else 'Tempo unavailable · placeholder 120 BPM · original timing preserved'
+    warnings = list(timeline.warnings)
+    if merged:
+        warnings.append(f'Quantization merged {merged} same-pitch attacks on the same grid point. Choose a finer subdivision or turn off Strict quantization to retain every attack.')
+    return dict(data=base64.b64encode(buffer.getvalue()).decode('ascii'), beat_grid=grid,
+                warnings=warnings, summary=summary, quantized=timeline.quantized,
+                notes=sorted(preview, key=lambda n:n['start']), duration=max([duration_from(timeline), *[n['end'] for n in preview]]))
+
+
+def duration_from(timeline):
+    return float(timeline.export_seconds(timeline.duration)-timeline.export_seconds(0))
+
+
+def click_wav(grid, duration):
+    """Small mono click file for desktop review; generated locally."""
+    import soundfile as sf
+    sr = 16000
+    duration = min(max(duration, 1), 3600)
+    audio = np.zeros(int((duration+.2)*sr), dtype=np.float32)
+    if grid:
+        downbeats = np.asarray(grid['downbeats'])
+        for second in sorted(set(grid['beats'] + grid['downbeats'])):
+            start = round(second*sr)
+            if not 0 <= start < len(audio):
+                continue
+            accented = len(downbeats) and np.min(abs(downbeats-second)) < .02
+            t = np.arange(min(int(.035*sr), len(audio)-start))/sr
+            audio[start:start+len(t)] += (.65 if accented else .35)*np.sin(2*np.pi*(1500 if accented else 1000)*t)*np.exp(-t*100)
+    buffer = io.BytesIO()
+    sf.write(buffer, audio, sr, format='WAV')
+    return buffer.getvalue()
diff --git a/muscriptor/utils/rhythm_evidence.py b/muscriptor/utils/rhythm_evidence.py
